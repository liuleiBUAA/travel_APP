# 微信小程序配置
WX_MINI_APPID=your_appid_here
WX_MINI_SECRET=your_secret_here

# Token 签名密钥（必须设置强随机值）
# 生成方式：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_SECRET=CHANGE_ME_TO_STRONG_RANDOM_SECRET

# 数据库配置（可选，默认使用 SQLite）
# DATABASE_URL=mysql://user:password@host:port/dbname

# 生产环境示例（请替换为真实值）：
# WX_MINI_APPID=wx1234567890abcdef
# WX_MINI_SECRET=abcdef1234567890abcdef1234567890
# TOKEN_SECRET=8n2Kx9Pq3Ym5Rt7Wz4Jh6Vb1Nc0Df8L
