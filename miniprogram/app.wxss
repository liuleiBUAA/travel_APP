/* ============================================================
   主题变量区  THEME START
   切换主题：把 miniprogram/themes/ 下任一主题文件的内容
   整段替换掉下面 THEME START ~ THEME END 之间的内容即可。
   当前主题：C 明快旅行风（theme-c-travel）
   ============================================================ */
page {
  /* 品牌色 */
  --c-primary: #ff6b5c;
  --c-primary-2: #ff8a5c;
  --grad-primary: linear-gradient(135deg, #ff7b5c 0%, #ff5c8a 100%);

  --c-accent: #2bb3c0;
  --grad-accent: linear-gradient(135deg, #2bb3c0 0%, #1e95c4 100%);

  --c-success: #14b8a6;
  --grad-success: linear-gradient(135deg, #2bd4a0 0%, #14b89a 100%);

  --c-danger: #ef4444;

  /* 背景 */
  --c-bg: #fef7f4;
  --c-card: #ffffff;
  --c-soft: #fff1ec;
  --c-input-bg: #fffaf8;

  /* 文字 */
  --c-text: #2a2320;
  --c-text-sub: #6b5f59;
  --c-text-muted: #a39690;
  --c-text-faint: #cabfb9;

  /* 描边 */
  --c-border: #f0e3dd;
  --c-border-soft: #f7eee9;

  /* 城市徽章 */
  --c-badge-bg: #e6f6f8;
  --c-badge-text: #1e95c4;

  /* 匹配分数条 */
  --c-score-route: #ff6b5c;
  --c-score-time: #2bb3c0;
  --c-score-pref: #f59e0b;

  /* 圆角 / 阴影 */
  --radius-card: 24rpx;
  --radius-ctrl: 16rpx;
  --shadow-card: 0 6rpx 22rpx rgba(255, 107, 92, 0.10);
}
/* ============================================================
   THEME END
   ============================================================ */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  background: var(--c-bg);
  color: var(--c-text);
  font-size: 28rpx;
}

.container {
  padding: 20rpx 30rpx;
}

.card {
  background: var(--c-card);
  border-radius: var(--radius-card);
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

/* 卡片标题：降噪，用深灰而非主色，避免每个标题都在抢视觉 */
.card-title {
  color: var(--c-text);
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
}

/* 标题左侧的主色竖条，作为唯一的品牌色锚点 */
.card-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: var(--grad-primary);
  margin-right: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--c-text-sub);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.form-hint {
  font-size: 24rpx;
  color: var(--c-text-sub);
  margin-top: 10rpx;
  line-height: 1.5;
}

.form-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--c-border);
  border-radius: var(--radius-ctrl);
  font-size: 30rpx;
  color: var(--c-text);
  background: var(--c-input-bg);
  box-sizing: border-box;
}

.form-group {
  margin-bottom: 28rpx;
}

.btn-primary {
  width: 100%;
  background: var(--grad-primary);
  color: #fff;
  border: none;
  border-radius: var(--radius-ctrl);
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
}

.btn-success {
  width: 100%;
  background: var(--grad-success);
  color: #fff;
  border: none;
  border-radius: var(--radius-ctrl);
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
}

.btn-secondary {
  width: 100%;
  background: var(--grad-accent);
  color: #fff;
  border: none;
  border-radius: var(--radius-ctrl);
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
}

.tag {
  display: inline-block;
  background: var(--grad-primary);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  margin: 6rpx;
}

.tag-remove {
  margin-left: 8rpx;
  font-weight: bold;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  min-height: 60rpx;
  padding: 10rpx;
  border: 2rpx dashed var(--c-border);
  border-radius: var(--radius-ctrl);
}

.msg-success {
  background: #e9f9f3;
  color: #0f9d75;
  padding: 20rpx;
  border-radius: var(--radius-ctrl);
  font-size: 26rpx;
  margin-top: 16rpx;
}

.msg-error {
  background: #fdecef;
  color: var(--c-danger);
  padding: 20rpx;
  border-radius: var(--radius-ctrl);
  font-size: 26rpx;
  margin-top: 16rpx;
}

.loading-text {
  text-align: center;
  color: var(--c-primary);
  padding: 30rpx;
  font-size: 28rpx;
}
