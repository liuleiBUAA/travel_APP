<view class="container">
  <view wx:if="{{loading}}" class="loading-text">加载中...</view>
  <view wx:elif="{{errorMsg}}" class="msg-error">{{errorMsg}}</view>

  <block wx:elif="{{playbook}}">

    <!-- ============ HERO 大图 ============ -->
    <view wx:if="{{playbook.hero}}" class="hero">
      <image class="hero-img" src="{{playbook.hero}}" mode="aspectFill" />
      <view class="hero-mask"></view>
      <view class="hero-ttl">
        <view class="hero-name">{{playbook.name}}</view>
        <view class="hero-sub">
          <text wx:if="{{playbook.city}}">{{playbook.country}} · {{playbook.city}}</text>
          <text wx:if="{{playbook.duration}}"> · 建议{{playbook.duration}}</text>
        </view>
      </view>
    </view>
    <!-- 无图时退化标题 -->
    <view wx:else class="card">
      <view class="pb-title">{{playbook.name}}</view>
      <view class="pb-meta">
        <text wx:if="{{playbook.city}}">📍 {{playbook.country}} · {{playbook.city}}</text>
        <text wx:if="{{playbook.duration}}">⏱ 建议{{playbook.duration}}</text>
      </view>
    </view>

    <view class="lead">{{playbook.summary}}</view>

    <!-- ==================================================== -->
    <!-- =============== 城市页 type=city ==================== -->
    <!-- ==================================================== -->
    <block wx:if="{{isCity}}">

      <!-- 1 交通（在前） -->
      <view class="sec">
        <view class="sec-h"><view class="bar"></view>交通 · 怎么到 / 玩转周边</view>
        <view wx:if="{{playbook.transport_map_url}}" class="maplbl">外部交通 · 城市间直飞 / 自驾</view>
        <view wx:if="{{playbook.transport_map_url}}" class="mapbox" bindtap="previewMap" data-url="{{playbook.transport_map_url}}">
          <image class="map-img" src="{{playbook.transport_map_url}}" mode="widthFix" />
          <view class="map-cap">点击查看大图 · 城市间交通图</view>
        </view>
        <view wx:if="{{playbook.transport_map_inner_url}}" class="maplbl">内部交通 · 市内景点 &amp; 通票</view>
        <view wx:if="{{playbook.transport_map_inner_url}}" class="mapbox" bindtap="previewMap" data-url="{{playbook.transport_map_inner_url}}">
          <image class="map-img" src="{{playbook.transport_map_inner_url}}" mode="widthFix" />
          <view class="map-cap">点击查看大图 · 市内交通景点图</view>
        </view>
        <view wx:if="{{playbook.transport.fly_train}}" class="tp-row"><text class="tp-k">✈ 飞机+火车</text>{{playbook.transport.fly_train}}</view>
        <view wx:if="{{playbook.transport.drive}}" class="tp-row"><text class="tp-k">🚗 自驾</text>{{playbook.transport.drive}}</view>
        <view wx:if="{{playbook.transport.local}}" class="tp-row"><text class="tp-k">🚶 镇内</text>{{playbook.transport.local}}</view>
      </view>

      <!-- 2 住哪里 -->
      <view wx:if="{{playbook.hotels.length}}" class="sec">
        <view class="sec-h"><view class="bar"></view>住哪里</view>
        <view wx:if="{{playbook.hotel_intro}}" class="lead-sm">{{playbook.hotel_intro}}</view>
        <view wx:for="{{playbook.hotels}}" wx:key="name" class="hotel" bindtap="copyHotelLink" data-link="{{item.link}}">
          <view class="hotel-score">{{item.score}}</view>
          <view class="hotel-info">
            <view class="hotel-name">{{item.name}} <text class="hotel-go">复制预订 ›</text></view>
            <view class="hotel-meta">{{item.area}} · {{item.star}}星 · {{item.reviews}}评价 · {{item.note}}</view>
          </view>
        </view>
      </view>

      <!-- 3 景点目录 -->
      <view wx:if="{{playbook.attractions.length}}" class="sec">
        <view class="sec-h"><view class="bar"></view>景点目录 · 点开看玩法</view>
        <view class="lead-sm">每个景点单独成页，含票价/时长/交通/路线/避坑。</view>
        <view class="grid">
          <view wx:for="{{playbook.attractions}}" wx:key="name" class="att-card"
                bindtap="openAttraction" data-name="{{item.name}}" data-hasdetail="{{item.has_detail}}">
            <view class="att-ph">
              <image wx:if="{{item.thumb}}" class="att-img" src="{{item.thumb}}" mode="aspectFill" />
              <view wx:if="{{item.order}}" class="att-num">{{item.order}}</view>
            </view>
            <view class="att-b">
              <view class="att-nm">{{item.display_name || item.name}}</view>
              <view class="att-ds">{{item.tagline}}</view>
              <view class="att-go">{{item.has_detail ? '查看玩法 ›' : '景点'}}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 4 行程安排 -->
      <view wx:if="{{playbook.itinerary.length}}" class="sec">
        <view class="sec-h"><view class="bar"></view>行程安排（建议{{playbook.duration}}）</view>
        <view wx:for="{{playbook.itinerary}}" wx:key="day" class="day">
          <view class="day-d">{{item.day}}</view>
          <view class="day-c"><text class="day-t">{{item.title}}</text>{{item.detail}}</view>
        </view>
      </view>

      <!-- 5 其余文字版块（实用贴士/两湖等） -->
      <view wx:for="{{playbook.sections}}" wx:key="title" class="sec">
        <view class="sec-h"><view class="bar"></view>{{item.title}}</view>
        <view class="sec-body">{{item.content}}</view>
      </view>
    </block>

    <!-- ==================================================== -->
    <!-- ============ 景点页 type=attraction ================= -->
    <!-- ==================================================== -->
    <block wx:else>

      <!-- 信息条 -->
      <view wx:if="{{playbook.facts.length}}" class="facts">
        <view wx:for="{{playbook.facts}}" wx:key="k" class="fact">
          <view class="fact-k">{{item.k}}</view>
          <view class="fact-v">{{item.v}}<text wx:if="{{item.sub}}" class="fact-sub"> {{item.sub}}</text></view>
        </view>
      </view>

      <!-- 推荐路线 -->
      <view wx:if="{{playbook.route.length}}" class="sec">
        <view class="sec-h"><view class="bar"></view>推荐路线</view>
        <view class="route">
          <block wx:for="{{playbook.route}}" wx:key="*this">
            <text class="route-stop">{{item}}</text>
            <text wx:if="{{index < playbook.route.length - 1}}" class="route-arr">→</text>
          </block>
        </view>
        <view wx:if="{{playbook.route_note}}" class="route-note">{{playbook.route_note}}</view>
      </view>

      <!-- 票价卡已移除：价格信息变动频繁，统一放入上方信息条(facts)作参考，以官网为准 -->

      <!-- 玩法分条 -->
      <view wx:if="{{playbook.activities.length}}" class="sec">
        <view class="sec-h"><view class="bar"></view>玩什么</view>
        <view wx:for="{{playbook.activities}}" wx:key="name" class="act">
          <view class="act-t">{{item.name}}<text wx:if="{{item.price}}" class="act-pr">{{item.price}}</text></view>
          <view class="act-m">{{item.detail}}</view>
        </view>
      </view>

      <!-- 图集 -->
      <view wx:if="{{playbook.gallery.length}}" class="sec">
        <view class="sec-h"><view class="bar"></view>实拍图集</view>
        <scroll-view class="gallery" scroll-x>
          <image wx:for="{{playbook.gallery}}" wx:for-item="pic" wx:key="url" class="gallery-img"
                 src="{{pic.url}}" mode="aspectFill" bindtap="previewGallery" data-url="{{pic.url}}" />
        </scroll-view>
      </view>

      <!-- 避坑 TIPS -->
      <view wx:if="{{playbook.tips.length}}" class="sec">
        <view class="sec-h"><view class="bar"></view>避坑 TIPS</view>
        <view class="tips">
          <view wx:for="{{playbook.tips}}" wx:key="*this" class="tip-li">{{item}}</view>
        </view>
      </view>

      <!-- 性价比替代 -->
      <view wx:if="{{playbook.alt}}" class="sec">
        <view class="alt-box"><text class="alt-k">💡 性价比替代</text>{{playbook.alt}}</view>
      </view>

      <!-- 详细文字版块（保留原 sections） -->
      <view wx:for="{{playbook.sections}}" wx:key="title" class="sec">
        <view class="sec-h"><view class="bar"></view>{{item.title}}</view>
        <view class="sec-body">{{item.content}}</view>
      </view>
    </block>

    <view class="foot">找搭子 · 旅行攻略</view>
  </block>
</view>
