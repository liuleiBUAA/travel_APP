page { background: #f2f4f7; }
.container { padding-bottom: 40rpx; }
.loading-text, .msg-error { text-align: center; color: #999; padding: 80rpx 0; }
.msg-error { color: #c0392b; }

/* ===== HERO ===== */
.hero { position: relative; width: 100%; height: 380rpx; overflow: hidden; }
.hero-img { width: 100%; height: 100%; }
.hero-mask { position: absolute; left: 0; right: 0; bottom: 0; height: 60%;
  background: linear-gradient(to top, rgba(0,0,0,.6), rgba(0,0,0,0)); }
.hero-ttl { position: absolute; left: 32rpx; bottom: 28rpx; color: #fff; }
.hero-name { font-size: 48rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-sub { font-size: 26rpx; opacity: .9; margin-top: 6rpx; }

/* fallback title */
.card { background: #fff; margin: 20rpx; padding: 28rpx; border-radius: 16rpx; }
.pb-title { font-size: 40rpx; font-weight: 700; color: #20457c; }
.pb-meta { font-size: 26rpx; color: #888; margin-top: 12rpx; }
.pb-meta text { margin-right: 20rpx; }

/* lead */
.lead { font-size: 27rpx; color: #555; line-height: 1.7; background: #fff;
  margin: 0 20rpx 20rpx; padding: 24rpx; border-radius: 16rpx;
  border-left: 8rpx solid #0099cc; }
.lead-sm { font-size: 25rpx; color: #777; line-height: 1.6; margin-bottom: 18rpx; }

/* section */
.sec { background: #fff; margin: 0 20rpx 20rpx; padding: 26rpx; border-radius: 16rpx; }
.sec-h { display: flex; align-items: center; font-size: 32rpx; font-weight: 700;
  color: #20457c; margin-bottom: 20rpx; }
.sec-h .bar { width: 8rpx; height: 32rpx; background: #0099cc; border-radius: 4rpx; margin-right: 14rpx; }
.sec-body { font-size: 27rpx; color: #444; line-height: 1.75; }

/* ===== 交通 ===== */
.mapbox { border-radius: 14rpx; overflow: hidden; border: 1rpx solid #e3e8ee; margin-bottom: 18rpx; }
.map-img { width: 100%; display: block; }
.map-cap { font-size: 23rpx; color: #888; text-align: center; padding: 12rpx; background: #fafbfc; }
.tp-row { font-size: 26rpx; color: #555; line-height: 1.7; margin-bottom: 12rpx; }
.tp-k { color: #20457c; font-weight: 600; margin-right: 10rpx; }

/* ===== 酒店 ===== */
.hotel { display: flex; gap: 18rpx; padding: 20rpx; border: 1rpx solid #eef1f5;
  border-radius: 14rpx; margin-bottom: 14rpx; }
.hotel-score { flex: 0 0 80rpx; height: 80rpx; background: #0099cc; color: #fff;
  border-radius: 12rpx; display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 32rpx; }
.hotel-info { flex: 1; }
.hotel-name { font-weight: 600; font-size: 28rpx; color: #20457c; }
.hotel-go { font-size: 22rpx; color: #0099cc; font-weight: 400; }
.hotel-meta { font-size: 23rpx; color: #888; margin-top: 6rpx; line-height: 1.5; }

/* ===== 景点目录网格 ===== */
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.att-card { width: 48.5%; background: #fff; border-radius: 16rpx; overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.08); margin-bottom: 18rpx; }
.att-ph { position: relative; width: 100%; height: 190rpx; background: #e8edf2; }
.att-img { width: 100%; height: 100%; }
.att-num { position: absolute; top: 12rpx; left: 12rpx; background: rgba(255,153,0,.95);
  color: #fff; font-size: 22rpx; width: 38rpx; height: 38rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-weight: 700; }
.att-b { padding: 16rpx 18rpx; }
.att-nm { font-weight: 700; font-size: 28rpx; color: #20457c; }
.att-ds { font-size: 22rpx; color: #777; margin-top: 6rpx; line-height: 1.4;
  min-height: 60rpx; }
.att-go { font-size: 22rpx; color: #0099cc; margin-top: 8rpx; font-weight: 600; }

/* ===== 行程 ===== */
.day { display: flex; gap: 18rpx; margin-bottom: 16rpx; }
.day-d { flex: 0 0 76rpx; height: 76rpx; background: #20457c; color: #fff;
  border-radius: 14rpx; display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700; }
.day-c { flex: 1; background: #f7f9fb; border-radius: 14rpx; padding: 16rpx 20rpx;
  font-size: 26rpx; color: #555; line-height: 1.5; white-space: pre-line; }
.day-t { display: block; color: #20457c; font-weight: 600; margin-bottom: 4rpx; }

/* ===== 信息条 ===== */
.facts { display: flex; flex-wrap: wrap; background: #fff; margin: 0 20rpx 20rpx;
  border-radius: 16rpx; overflow: hidden; }
.fact { width: 50%; padding: 22rpx 26rpx; box-sizing: border-box;
  border-bottom: 1rpx solid #eef1f5; }
.fact:nth-child(odd) { border-right: 1rpx solid #eef1f5; }
.fact-k { font-size: 23rpx; color: #999; }
.fact-v { font-size: 30rpx; color: #20457c; font-weight: 700; margin-top: 6rpx; }
.fact-sub { font-size: 22rpx; color: #999; font-weight: 400; }

/* ===== 路线 ===== */
.route { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx;
  background: #f0f7fb; border-radius: 14rpx; padding: 20rpx; }
.route-stop { background: #0099cc; color: #fff; padding: 8rpx 18rpx; border-radius: 24rpx;
  font-size: 25rpx; font-weight: 600; }
.route-arr { color: #0099cc; font-weight: 700; }
.route-note { font-size: 23rpx; color: #888; margin-top: 14rpx; line-height: 1.6; }

/* ===== 票价卡 ===== */
.price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12rpx;
  background: linear-gradient(135deg, #0099cc, #20457c); color: #fff;
  border-radius: 16rpx; padding: 26rpx 30rpx; margin-bottom: 16rpx; }
.price-big { font-size: 52rpx; font-weight: 700; }
.price-u { font-size: 26rpx; opacity: .9; }
.price-note { margin-left: auto; font-size: 23rpx; opacity: .92; }

/* ===== 玩法 ===== */
.act { border: 1rpx solid #eef1f5; border-radius: 14rpx; padding: 20rpx 22rpx; margin-bottom: 14rpx; }
.act-t { font-weight: 700; color: #20457c; font-size: 28rpx; display: flex;
  justify-content: space-between; align-items: center; }
.act-pr { font-size: 22rpx; background: #fff1d6; color: #c47e00; padding: 4rpx 14rpx;
  border-radius: 18rpx; font-weight: 700; }
.act-m { font-size: 24rpx; color: #777; margin-top: 10rpx; line-height: 1.6; }

/* ===== 图集 ===== */
.gallery { white-space: nowrap; }
.gallery-img { display: inline-block; width: 320rpx; height: 220rpx; border-radius: 12rpx;
  margin-right: 14rpx; }

/* ===== TIPS ===== */
.tips { background: #fff8ec; border: 1rpx solid #ffe3b0; border-radius: 14rpx; padding: 22rpx; }
.tip-li { font-size: 25rpx; color: #7a5b1e; padding: 8rpx 0 8rpx 36rpx; position: relative; line-height: 1.6; }
.tip-li::before { content: "⚠"; position: absolute; left: 6rpx; top: 8rpx; font-size: 22rpx; }

/* ===== 替代方案 ===== */
.alt-box { background: #eef7f0; border-left: 8rpx solid #2e7d32; border-radius: 0 12rpx 12rpx 0;
  padding: 20rpx 22rpx; font-size: 25rpx; color: #2e5e36; line-height: 1.65; }
.alt-k { display: block; font-weight: 700; margin-bottom: 6rpx; }

.foot { text-align: center; color: #bbb; font-size: 22rpx; padding: 30rpx 0; }
