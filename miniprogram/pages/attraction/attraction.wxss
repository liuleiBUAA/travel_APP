.loading-text {
  color: var(--c-text-muted);
  font-size: 26rpx;
  text-align: center;
  padding: 80rpx 0;
}

.pb-title {
  font-size: 38rpx;
  font-weight: 600;
}

.pb-meta {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: var(--c-text-muted);
  margin-top: 12rpx;
}

.pb-summary {
  font-size: 28rpx;
  line-height: 1.7;
  margin-top: 16rpx;
}

.pb-best-time {
  font-size: 24rpx;
  color: var(--c-primary);
  background: rgba(255, 107, 92, 0.08);
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  margin-top: 16rpx;
}

.pb-section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.pb-section-content {
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--c-text-sub, #555);
}
