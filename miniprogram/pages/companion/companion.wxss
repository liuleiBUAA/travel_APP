/* 模式切换（与做攻略一致） */
.mode-list {
  display: flex;
  gap: 16rpx;
}

.mode-btn {
  flex: 1;
  padding: 16rpx;
  background: var(--c-card);
  border: 2rpx solid var(--c-border);
  border-radius: var(--radius-ctrl);
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--c-text-sub);
}

.mode-btn.active {
  background: var(--grad-primary);
  color: #fff;
  border-color: var(--c-primary);
}
