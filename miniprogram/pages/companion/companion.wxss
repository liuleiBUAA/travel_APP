.companion {
  min-height: 100vh;
  background: var(--c-bg);
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.greeting {
  margin-bottom: 44rpx;
  padding: 0 10rpx;
}

.greeting-hi {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 10rpx;
}

.greeting-sub {
  font-size: 28rpx;
  color: var(--c-text-muted);
}

.cards {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.big-card {
  border-radius: 28rpx;
  padding: 44rpx 40rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(30, 40, 80, 0.12);
}

.big-card-hover {
  transform: scale(0.98);
  opacity: 0.94;
}

.card-publish {
  background: var(--grad-primary);
}

.card-search {
  background: var(--grad-accent);
}

.big-card-emoji {
  font-size: 76rpx;
  margin-bottom: 20rpx;
}

.big-card-title {
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.big-card-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.6;
  margin-bottom: 28rpx;
  max-width: 460rpx;
}

.big-card-go {
  display: inline-block;
  font-size: 26rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.22);
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
}
