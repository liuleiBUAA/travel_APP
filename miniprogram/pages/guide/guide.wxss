.hint-text {
  color: var(--c-text-muted);
  font-size: 24rpx;
  padding: 16rpx;
}

/* 模式切换 */
.mode-list {
  display: flex;
  gap: 16rpx;
}

.mode-btn {
  flex: 1;
  padding: 16rpx;
  background: var(--c-card);
  border: 2rpx solid var(--c-border);
  border-radius: var(--radius-ctrl);
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--c-text-sub);
}

.mode-btn.active {
  background: var(--grad-primary);
  color: #fff;
  border-color: var(--c-primary);
}

/* 城市网格（知道去哪模式） */
.city-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.city-item {
  width: calc(33% - 8rpx);
  padding: 16rpx 10rpx;
  background: var(--c-soft);
  border: 1rpx solid var(--c-border);
  border-radius: 10rpx;
  text-align: center;
  box-sizing: border-box;
}

.city-item.selected {
  background: var(--c-primary);
  color: #fff;
  border-color: var(--c-primary);
}

.city-item.selected .city-info {
  color: rgba(255,255,255,0.8);
}

.city-name {
  font-size: 26rpx;
  font-weight: 500;
}

.city-info {
  font-size: 20rpx;
  color: var(--c-text-muted);
  margin-top: 4rpx;
}

.clear-btn {
  color: var(--c-danger);
  font-size: 24rpx;
}

/* 折叠条 */
.more-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 24rpx;
  background: var(--c-soft);
  border-radius: var(--radius-ctrl);
  font-size: 28rpx;
  color: var(--c-text-sub);
  margin: 24rpx 0;
}

.more-arrow {
  color: var(--c-primary);
  font-size: 26rpx;
}

.region-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.region-btn {
  flex: 1;
  min-width: 120rpx;
  padding: 14rpx;
  background: var(--c-card);
  border: 2rpx solid var(--c-border);
  border-radius: 10rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--c-text-sub);
}

.region-btn.active {
  background: var(--grad-primary);
  color: #fff;
  border-color: var(--c-primary);
}

.country-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.country-btn {
  padding: 12rpx 20rpx;
  background: var(--c-card);
  border: 2rpx solid var(--c-border);
  border-radius: 10rpx;
  font-size: 24rpx;
  color: var(--c-text-sub);
}

.country-btn.active {
  background: var(--grad-accent);
  color: #fff;
  border-color: var(--c-accent);
}

.country-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx;
  border: 2rpx solid var(--c-border);
  border-radius: var(--radius-ctrl);
  background: var(--c-card);
}

.checkbox-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag-btn {
  padding: 12rpx 20rpx;
  background: var(--c-soft);
  border: 2rpx solid var(--c-border);
  border-radius: 10rpx;
  font-size: 24rpx;
}

.tag-btn.active {
  background: var(--c-primary);
  color: #fff;
  border-color: var(--c-primary);
}

.recommend-result {
  margin-top: 20rpx;
  padding: 20rpx;
  background: var(--c-soft);
  border-radius: var(--radius-ctrl);
}

.option-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
}

.summary {
  display: flex;
  background: var(--c-soft);
  border-radius: var(--radius-ctrl);
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-number {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--c-primary);
}

.summary-label {
  font-size: 22rpx;
  color: var(--c-text-sub);
  margin-top: 6rpx;
}

.route-cities {
  font-size: 26rpx;
  color: var(--c-primary);
  padding: 16rpx;
  background: var(--c-soft);
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  line-height: 1.8;
}

.day-card {
  background: var(--c-card);
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-radius: var(--radius-ctrl);
  border-left: 6rpx solid var(--c-primary);
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.day-number {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-primary);
}

.day-stay {
  font-size: 24rpx;
  color: var(--c-text-sub);
  background: var(--c-soft);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--c-border);
}

.day-activity {
  font-size: 26rpx;
  color: var(--c-text);
  line-height: 1.8;
  padding: 12rpx;
  background: var(--c-input-bg);
  border-radius: 8rpx;
  margin-bottom: 10rpx;
}

.day-transport {
  font-size: 24rpx;
  color: var(--c-text-sub);
  padding: 10rpx 12rpx;
  background: var(--c-soft);
  border-radius: 8rpx;
}

.day-images {
  white-space: nowrap;
  margin-bottom: 10rpx;
}

.day-image-wrap {
  display: inline-block;
  margin-right: 12rpx;
}

.day-image {
  width: 320rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background: var(--c-soft);
}

.day-image-name {
  font-size: 22rpx;
  color: var(--c-text-sub);
  text-align: center;
  margin-top: 4rpx;
}

.image-credit {
  font-size: 20rpx;
  color: var(--c-text-sub);
  text-align: center;
  margin: 16rpx 0;
  opacity: 0.7;
}
