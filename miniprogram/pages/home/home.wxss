.home {
  min-height: 100vh;
  background: var(--c-bg);
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

/* 顶部 hero */
.hero {
  position: relative;
  margin-bottom: 40rpx;
  padding: 10rpx 10rpx 0;
  overflow: hidden;
}

.hero-deco {
  position: absolute;
  font-size: 60rpx;
  opacity: 0.12;
}

.deco-1 {
  top: 0;
  right: 40rpx;
  transform: rotate(15deg);
  font-size: 90rpx;
}

.deco-2 {
  top: 60rpx;
  right: 160rpx;
  font-size: 56rpx;
}

.greeting-hi {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 10rpx;
}

.greeting-sub {
  font-size: 28rpx;
  color: var(--c-text-muted);
}

/* 主入口卡片 */
.cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 找搭子：主视觉大卡 */
.hero-card {
  position: relative;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  background: var(--grad-primary);
  color: #fff;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(255, 107, 92, 0.28);
}

.hero-card-hover {
  transform: scale(0.985);
  opacity: 0.96;
}

.hero-card-emoji {
  font-size: 68rpx;
  line-height: 1;
}

.hero-card-title {
  font-size: 44rpx;
  font-weight: 800;
  margin-top: 16rpx;
  letter-spacing: -0.5rpx;
}

.hero-card-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 10rpx;
  line-height: 1.5;
}

.hero-card-cta {
  display: inline-block;
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.24);
  border-radius: 14rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.hero-card-bg {
  position: absolute;
  right: -16rpx;
  bottom: -32rpx;
  font-size: 200rpx;
  opacity: 0.15;
  line-height: 1;
}

/* 做攻略：次级横条 */
.sub-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--c-card);
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  box-shadow: var(--shadow-card);
}

.sub-card-hover {
  transform: scale(0.985);
  opacity: 0.94;
}

.sub-card-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: var(--c-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.sub-card-text {
  flex: 1;
  min-width: 0;
}

.sub-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--c-text);
}

.sub-card-desc {
  font-size: 25rpx;
  color: var(--c-text-muted);
  margin-top: 6rpx;
}

.sub-card-arrow {
  font-size: 40rpx;
  color: var(--c-text-faint);
  flex-shrink: 0;
}

/* 最新搭子动态 */
.recent-section {
  margin-top: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 6rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
}

.section-more {
  font-size: 26rpx;
  color: var(--c-primary);
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.buddy-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--c-card);
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  box-shadow: var(--shadow-card);
}

.buddy-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffd0ca, #ffb3a8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.buddy-info {
  flex: 1;
  min-width: 0;
}

.buddy-cities {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.buddy-tags {
  margin: 10rpx 0 8rpx;
}

.buddy-tag {
  display: inline-block;
  font-size: 22rpx;
  color: var(--c-text-sub);
  background: var(--c-soft);
  border-radius: 999rpx;
  padding: 5rpx 16rpx;
  margin-right: 10rpx;
}

.buddy-user {
  font-size: 24rpx;
  color: var(--c-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.buddy-date {
  text-align: center;
  flex-shrink: 0;
}

.buddy-date-num {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--c-primary);
}

.buddy-date-label {
  font-size: 20rpx;
  color: var(--c-text-muted);
  margin-top: 2rpx;
}

/* 快捷入口 */
.quick-row {
  display: flex;
  gap: 24rpx;
  margin-top: 36rpx;
}

.quick-item {
  flex: 1;
  background: var(--c-card);
  border-radius: 20rpx;
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-shadow: var(--shadow-card);
}

.quick-emoji {
  font-size: 44rpx;
}

.quick-text {
  font-size: 26rpx;
  color: var(--c-text-sub);
}


/* 悬浮语音助手入口 */
.voice-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(135deg, #ff8a5c, #ff5c8a);
  color: #fff;
  border-radius: 999rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(255,92,138,0.4);
  z-index: 999;
}
.voice-fab-icon { font-size: 40rpx; }
.voice-fab-text { font-size: 28rpx; font-weight: 600; }
