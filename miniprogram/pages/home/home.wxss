.home {
  min-height: 100vh;
  background: var(--c-bg);
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

/* 顶部 hero */
.hero {
  position: relative;
  margin-bottom: 40rpx;
  padding: 10rpx 10rpx 0;
  overflow: hidden;
}

.hero-deco {
  position: absolute;
  font-size: 60rpx;
  opacity: 0.12;
}

.deco-1 {
  top: 0;
  right: 40rpx;
  transform: rotate(15deg);
  font-size: 90rpx;
}

.deco-2 {
  top: 60rpx;
  right: 160rpx;
  font-size: 56rpx;
}

.greeting-hi {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 10rpx;
}

.greeting-sub {
  font-size: 28rpx;
  color: var(--c-text-muted);
}

/* 两大主线卡片 */
.cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.big-card {
  border-radius: 28rpx;
  padding: 36rpx 36rpx 30rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 92, 0.18);
}

.big-card-hover {
  transform: scale(0.98);
  opacity: 0.94;
}

.card-guide {
  background: var(--grad-primary);
}

.card-match {
  background: var(--grad-accent);
  box-shadow: 0 10rpx 30rpx rgba(43, 179, 192, 0.18);
}

.big-card-body {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.big-card-emoji {
  font-size: 72rpx;
  flex-shrink: 0;
}

.big-card-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.big-card-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.5;
}

.big-card-go {
  display: inline-block;
  font-size: 26rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.22);
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
}

/* 最新搭子动态 */
.recent-section {
  margin-top: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 6rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
}

.section-more {
  font-size: 26rpx;
  color: var(--c-primary);
}

.recent-scroll {
  white-space: nowrap;
}

.recent-row {
  display: inline-flex;
  gap: 20rpx;
  padding-bottom: 8rpx;
}

.recent-card {
  display: inline-block;
  width: 360rpx;
  background: var(--c-card);
  border-radius: 20rpx;
  padding: 26rpx;
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.recent-cities {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text);
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recent-meta {
  font-size: 24rpx;
  color: var(--c-primary);
  margin-bottom: 8rpx;
}

.recent-user {
  font-size: 24rpx;
  color: var(--c-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 快捷入口 */
.quick-row {
  display: flex;
  gap: 24rpx;
  margin-top: 36rpx;
}

.quick-item {
  flex: 1;
  background: var(--c-card);
  border-radius: 20rpx;
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-shadow: var(--shadow-card);
}

.quick-emoji {
  font-size: 44rpx;
}

.quick-text {
  font-size: 26rpx;
  color: var(--c-text-sub);
}


/* 悬浮语音助手入口 */
.voice-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(135deg, #ff8a5c, #ff5c8a);
  color: #fff;
  border-radius: 999rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(255,92,138,0.4);
  z-index: 999;
}
.voice-fab-icon { font-size: 40rpx; }
.voice-fab-text { font-size: 28rpx; font-weight: 600; }
