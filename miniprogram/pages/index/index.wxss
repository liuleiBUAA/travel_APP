.region-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.region-btn {
  flex: 1;
  min-width: 140rpx;
  padding: 16rpx;
  background: var(--c-card);
  border: 2rpx solid var(--c-border);
  border-radius: var(--radius-ctrl);
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--c-text-sub);
}

.region-btn.active {
  background: var(--grad-primary);
  color: #fff;
  border-color: var(--c-primary);
}

.country-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.country-btn {
  padding: 14rpx 24rpx;
  background: var(--c-card);
  border: 2rpx solid var(--c-border);
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--c-text-sub);
}

.country-btn.active {
  background: var(--grad-accent);
  color: #fff;
  border-color: var(--c-accent);
}

.city-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.city-item {
  width: calc(33% - 8rpx);
  padding: 16rpx 10rpx;
  background: var(--c-soft);
  border: 1rpx solid var(--c-border);
  border-radius: 10rpx;
  text-align: center;
  box-sizing: border-box;
}

.city-item.selected {
  background: var(--c-primary);
  color: #fff;
  border-color: var(--c-primary);
}

.city-item.selected .city-info {
  color: rgba(255,255,255,0.8);
}

.city-name {
  font-size: 26rpx;
  font-weight: 500;
}

.city-info {
  font-size: 20rpx;
  color: var(--c-text-muted);
  margin-top: 4rpx;
}

.hint-text {
  color: var(--c-text-muted);
  font-size: 24rpx;
  padding: 16rpx;
  width: 100%;
}

.search-results {
  border: 1rpx solid var(--c-border);
  border-top: none;
  border-radius: 0 0 12rpx 12rpx;
  max-height: 300rpx;
  overflow-y: auto;
  background: var(--c-card);
}

.search-item {
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid var(--c-border-soft);
  font-size: 26rpx;
}

.row {
  display: flex;
  align-items: center;
}

.checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx;
  border: 2rpx solid var(--c-border);
  border-radius: var(--radius-ctrl);
}

.checkbox-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
}

.clear-btn {
  color: var(--c-danger);
  font-size: 24rpx;
}

.user-card {
  padding: 20rpx 30rpx;
}

.user-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-text);
}

.edit-btn {
  color: var(--c-primary);
  font-size: 24rpx;
}

.edit-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.save-btn {
  color: var(--c-primary);
  font-size: 26rpx;
  font-weight: 500;
}

.cancel-btn {
  color: var(--c-text-muted);
  font-size: 26rpx;
}

/* 输入模式切换 */
.mode-list {
  display: flex;
  gap: 16rpx;
}

.mode-btn {
  flex: 1;
  padding: 16rpx;
  background: var(--c-card);
  border: 2rpx solid var(--c-border);
  border-radius: var(--radius-ctrl);
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--c-text-sub);
}

.mode-btn.active {
  background: var(--grad-primary);
  color: #fff;
  border-color: var(--c-primary);
}

/* 手动输入模式 */
.form-textarea {
  width: 100%;
  padding: 16rpx;
  background: var(--c-input-bg);
  border: 2rpx solid var(--c-border);
  border-radius: var(--radius-ctrl);
  font-size: 26rpx;
  resize: vertical;
}

.picker-input {
  background: var(--c-input-bg);
  padding: 16rpx;
  border-radius: var(--radius-ctrl);
  font-size: 26rpx;
}

.manual-preview {
  margin-top: 24rpx;
  padding: 20rpx;
  background: var(--c-soft);
  border-radius: var(--radius-ctrl);
  border-left: 6rpx solid var(--c-primary);
}

.preview-title {
  font-size: 24rpx;
  color: var(--c-text-sub);
  margin-bottom: 8rpx;
}

.preview-content {
  font-size: 28rpx;
  color: var(--c-text);
  font-weight: 500;
}
