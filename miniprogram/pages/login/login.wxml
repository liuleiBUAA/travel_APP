<view class="login-page">
  <view class="login-body">
    <view class="brand">
      <view class="logo-circle">✈️</view>
      <text class="brand-name">找搭子</text>
      <text class="brand-slogan">生成专属攻略 · 找到同行旅伴</text>
    </view>

    <view class="login-actions">
      <!-- 协议勾选：默认不勾选，不勾选不登录 -->
      <view class="agree-row">
        <view class="agree-box {{agreed ? 'checked' : ''}}" bindtap="onToggleAgree">
          <text wx:if="{{agreed}}" class="agree-tick">✓</text>
        </view>
        <view class="agree-text">
          <text bindtap="onToggleAgree">我已阅读并同意</text>
          <text class="agree-link" catchtap="openService">《用户服务协议》</text>
          <text bindtap="onToggleAgree">和</text>
          <text class="agree-link" catchtap="openPrivacy">《隐私政策》</text>
        </view>
      </view>

      <button class="btn-wechat" bindtap="onWxLogin" loading="{{logging}}" disabled="{{logging}}">
        <text class="wechat-icon">💬</text> 微信一键登录
      </button>

      <view wx:if="{{errorMsg}}" class="login-error">{{errorMsg}}</view>

      <text class="login-skip" bindtap="onSkip">暂不登录，先去逛逛</text>
    </view>
  </view>
</view>
