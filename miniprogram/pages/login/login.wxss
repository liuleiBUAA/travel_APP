.login-page {
  min-height: 100vh;
  background: var(--grad-primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  box-sizing: border-box;
}

/* 启动校验态 */
.checking {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.checking-text {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  margin-top: 24rpx;
}

/* 登录主体 */
.login-body {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 90rpx;
  margin-bottom: 36rpx;
}

.brand-name {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.brand-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

.login-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn-wechat {
  width: 100%;
  background: #fff;
  color: var(--c-primary);
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-wechat[disabled] {
  opacity: 0.7;
}

.wechat-icon {
  margin-right: 12rpx;
}

.login-error {
  color: #fff5f5;
  background: rgba(0, 0, 0, 0.18);
  font-size: 26rpx;
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  margin-top: 28rpx;
}

.login-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 40rpx;
}

/* 协议勾选行（默认不勾选） */
.agree-row {
  width: 100%;
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.agree-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 14rpx;
  margin-top: 2rpx;
}

.agree-box.checked {
  background: #fff;
  border-color: #fff;
}

.agree-tick {
  font-size: 24rpx;
  color: var(--c-primary);
  font-weight: 700;
  line-height: 1;
}

.agree-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.9);
}

/* 协议超链接：微信/淘宝同款蓝色文字，无下划线 */
.agree-link {
  color: #66B3FF;
  font-weight: 600;
}

.login-skip {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 40rpx;
  padding: 12rpx 30rpx;
  text-decoration: underline;
}
