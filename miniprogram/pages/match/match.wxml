<view class="container">
  <!-- 搜索搭子 -->
  <view class="card">
    <view class="card-title">搜索搭子</view>
    <view class="form-group">
      <view class="form-label">输入目的地关键词（城市/国家）</view>
      <view class="search-bar">
        <input class="form-input search-input" placeholder="例如：日本、巴黎、意大利" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="doSearch" />
        <button class="btn-search" bindtap="doSearch">搜索</button>
      </view>
    </view>
    <view wx:if="{{searchLoading}}" class="loading-text">搜索中...</view>
    <view wx:if="{{searchResults.length > 0}}" class="search-result-hint">找到 {{searchResults.length}} 条相关路线</view>
    <view wx:for="{{searchResults}}" wx:key="companion_id" class="match-card" bindtap="goToDetail" data-id="{{item.companion_id}}">
      <view class="match-user">{{item.user_name || '匿名'}}</view>
      <view class="match-date">{{item.travel_date || '待定'}} · {{item.duration_days || 0}}天</view>
      <view class="match-cities">
        <view wx:for="{{item.route.cities}}" wx:for-item="city" wx:key="*this" class="city-badge">{{city}}</view>
      </view>
      <view class="match-info">
        <text>{{item.current_people || '未知'}} · {{item.transport_mode || '不限'}} · {{item.budget_level || '经济'}}</text>
      </view>
    </view>
    <view wx:if="{{searchDone && searchResults.length === 0}}" class="hint-text">未找到相关路线，换个关键词试试</view>
  </view>

  <!-- 匹配条件 -->
  <view class="card">
    <view class="card-title">精确匹配</view>

    <view class="form-group">
      <view class="form-label">你的路线</view>
      <view class="tags-wrap">
        <view wx:if="{{selectedCities.length === 0}}" class="hint-text">请先在「发布行程」页选择城市</view>
        <view wx:for="{{selectedCities}}" wx:key="*this" class="tag">{{item}}</view>
      </view>
    </view>

    <view class="form-group">
      <view class="form-label">出发日期</view>
      <picker mode="date" value="{{matchDate}}" bindchange="onDateChange">
        <view class="form-input">{{matchDate}}</view>
      </picker>
    </view>

    <view class="form-group">
      <view class="form-label">时间灵活度</view>
      <picker range="{{flexOptions}}" range-key="label" value="{{flexIndex}}" bindchange="onFlexChange">
        <view class="form-input">{{flexOptions[flexIndex].label}}</view>
      </picker>
    </view>

    <view class="form-group">
      <view class="form-label">找搭子人数（可选）</view>
      <view class="row" style="display:flex;align-items:center;gap:8rpx;">
        <input class="form-input" style="width:35%;" type="number" value="{{peopleMin}}" bindinput="onMatchInput" data-field="peopleMin" placeholder="最少" />
        <text>-</text>
        <input class="form-input" style="width:35%;" type="number" value="{{peopleMax}}" bindinput="onMatchInput" data-field="peopleMax" placeholder="最多" />
        <text>人</text>
      </view>
    </view>

    <view class="form-group">
      <view class="form-label">性别要求（可选）</view>
      <picker range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onPickerChange" data-field="genderIndex">
        <view class="form-input">{{genderOptions[genderIndex]}}</view>
      </picker>
    </view>

    <view class="form-group">
      <view class="form-label">交通方式（可选）</view>
      <picker range="{{transportOptions}}" value="{{transportIndex}}" bindchange="onPickerChange" data-field="transportIndex">
        <view class="form-input">{{transportOptions[transportIndex]}}</view>
      </picker>
    </view>

    <view class="form-group">
      <view class="form-label">住宿安排（可选）</view>
      <picker range="{{accommodationOptions}}" value="{{accommodationIndex}}" bindchange="onPickerChange" data-field="accommodationIndex">
        <view class="form-input">{{accommodationOptions[accommodationIndex]}}</view>
      </picker>
    </view>

    <view class="form-group">
      <view class="form-label">消费水平（可选，多选）</view>
      <view class="checkbox-group">
        <checkbox-group wx:for="{{budgetOptions}}" wx:key="*this" bindchange="toggleBudget" data-value="{{item}}">
          <label class="checkbox-item">
            <checkbox value="{{item}}" />
            <text>{{item}}</text>
          </label>
        </checkbox-group>
      </view>
    </view>

    <view class="form-group">
      <view class="form-label">拍照技能（可选）</view>
      <picker range="{{photoOptions}}" value="{{photoIndex}}" bindchange="onPickerChange" data-field="photoIndex">
        <view class="form-input">{{photoOptions[photoIndex]}}</view>
      </picker>
    </view>

    <view class="form-group">
      <view class="form-label">你们的组成（可选）</view>
      <view class="row" style="display:flex;align-items:center;gap:8rpx;">
        <input class="form-input" style="width:35%;" type="number" value="{{userMaleCount}}" bindinput="onMatchInput" data-field="userMaleCount" placeholder="男生" />
        <text>男</text>
        <input class="form-input" style="width:35%;" type="number" value="{{userFemaleCount}}" bindinput="onMatchInput" data-field="userFemaleCount" placeholder="女生" />
        <text>女</text>
      </view>
    </view>

    <button class="btn-secondary" bindtap="startMatch">开始匹配</button>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-text">正在匹配...</view>

  <!-- 匹配结果 -->
  <view wx:if="{{matchCount >= 0 && !loading}}" class="card">
    <view class="card-title">匹配结果（{{matchCount}}人）</view>

    <view wx:if="{{matches.length === 0}}" class="hint-text">暂无匹配结果</view>

    <view wx:for="{{matches}}" wx:key="companion_id" class="match-card" bindtap="goToDetail" data-id="{{item.companion_id}}">
      <view class="match-header">
        <view class="match-user">{{item.user_name || '匿名'}}</view>
        <view class="match-score">{{item.match_score_pct || 0}}%</view>
      </view>

      <view class="match-date">{{item.travel_date || '待定'}} · {{item.duration_days || 0}}天</view>

      <view class="match-cities">
        <view wx:for="{{item.route.cities}}" wx:for-item="city" wx:key="*this" class="city-badge">{{city}}</view>
      </view>

      <view class="match-info">
        <text>{{item.user_male_count || 0}}男{{item.user_female_count || 0}}女 · 找{{item.seeking.people_min || 1}}-{{item.seeking.people_max || 2}}人 · {{item.seeking.gender || '不限'}}</text>
        <view class="match-info-text">{{item.transport_mode || '不限'}} · {{item.accommodation || '不限'}} · {{item.budget_level || '经济'}}</view>
      </view>

      <view class="match-scores">
        <view class="score-item">
          <view class="score-bar" style="width: {{(item.similarity_score || 0) * 100}}%"></view>
          <text>路线 {{item.similarity_score_pct || 0}}%</text>
        </view>
        <view class="score-item">
          <view class="score-bar time" style="width: {{(item.time_score || 0) * 100}}%"></view>
          <text>时间 {{item.time_score_pct || 0}}%</text>
        </view>
        <view class="score-item">
          <view class="score-bar pref" style="width: {{(item.preference_score || 0) * 100}}%"></view>
          <text>偏好 {{item.preference_score_pct || 0}}%</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 已发布列表 -->
  <view class="card">
    <view class="card-title">最近发布</view>
    <view wx:if="{{companions.length === 0}}" class="hint-text">暂无发布</view>
    <view wx:for="{{companions}}" wx:key="id" class="companion-card" bindtap="goToDetail" data-id="{{item.companion_id}}">
      <view class="match-user">{{item.user_name || '匿名'}}</view>
      <view class="match-date">{{item.travel_date || '待定'}} · {{item.duration_days || 0}}天</view>
      <view class="match-cities">
        <view wx:for="{{item.route.cities}}" wx:for-item="city" wx:key="*this" class="city-badge">{{city}}</view>
      </view>
    </view>
  </view>
</view>
