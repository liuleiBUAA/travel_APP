<view class="container">
  <!-- 未登录状态 -->
  <view wx:if="{{!isLoggedIn}}" class="login-section">
    <view class="avatar-placeholder">
      <text class="avatar-icon">👤</text>
    </view>
    <text class="login-hint">登录后享受更多功能</text>

    <view class="card">
      <view wx:if="{{errorMsg}}" class="msg-error">{{errorMsg}}</view>
      <button class="btn-wechat" bindtap="onPhoneLogin">
        <text class="wechat-icon">💬</text> 微信一键登录
      </button>
    </view>
  </view>

  <!-- 完善资料弹窗 -->
  <view wx:if="{{showProfileSetup}}" class="profile-setup-mask">
    <view class="profile-setup-dialog">
      <text class="setup-title">完善个人资料</text>
      <text class="setup-hint">设置你的昵称和头像，让搭子更容易认识你</text>

      <view class="setup-avatar-wrap">
        <button class="setup-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="setup-avatar-img" src="{{tempAvatarUrl || '/images/default_avatar.png'}}" mode="aspectFill" />
          <text class="setup-avatar-text">点击选择头像</text>
        </button>
      </view>

      <view class="setup-nickname-wrap">
        <input type="nickname" class="setup-nickname-input" placeholder="点击获取微信昵称" value="{{tempNickname}}" bindchange="onNicknameChange" />
      </view>

      <view class="setup-btns">
        <button class="setup-btn-skip" bindtap="onSkipSetup">跳过</button>
        <button class="setup-btn-confirm" bindtap="onConfirmSetup">确认</button>
      </view>
    </view>
  </view>

  <!-- 已登录状态 -->
  <view wx:else class="profile-section">
    <view class="profile-header">
      <image class="avatar" src="{{userInfo.avatar_url || '/images/default_avatar.png'}}" mode="aspectFill" />
      <view class="profile-info">
        <text class="nickname">{{userInfo.nickname || userInfo.nickName || '旅行者'}}</text>
      </view>
    </view>

    <!-- 旅行名片 -->
    <view class="card travel-card">
      <view class="card-title-row">
        <text class="card-title">我的旅行名片</text>
        <text wx:if="{{!cardEditing}}" class="card-edit-btn" bindtap="onEditCard">编辑</text>
      </view>

      <!-- 展示态 -->
      <block wx:if="{{!cardEditing}}">
        <view wx:if="{{card.bio}}" class="card-bio">{{card.bio}}</view>
        <view class="card-tags">
          <text wx:if="{{card.budget_level}}" class="card-tag">💰 {{card.budget_level}}</text>
          <text wx:if="{{card.good_at_photo}}" class="card-tag">📷 拍照{{card.good_at_photo}}</text>
          <text wx:if="{{card.accommodation_pref}}" class="card-tag">🏨 {{card.accommodation_pref}}</text>
          <text wx:if="{{card.driving}}" class="card-tag">🚗 {{card.driving}}</text>
          <text wx:for="{{card.tags}}" wx:key="*this" class="card-tag">{{item}}</text>
        </view>
        <view wx:if="{{!card.bio && !card.budget_level && !card.good_at_photo && !card.accommodation_pref && !card.driving && card.tags.length === 0}}" class="hint-text">
          完善名片，让搭子提前了解你（发帖时自动带入）
        </view>
      </block>

      <!-- 编辑态 -->
      <block wx:else>
        <view class="card-form-item">
          <text class="card-form-label">自我介绍</text>
          <textarea class="card-bio-input" value="{{editBio}}" maxlength="200" placeholder="一句话介绍自己，比如：爱摄影爱美食，求靠谱搭子" bindinput="onBioInput" auto-height />
        </view>
        <view class="card-form-item">
          <text class="card-form-label">消费习惯</text>
          <picker range="{{budgetOptions}}" value="{{budgetIndex}}" bindchange="onBudgetChange">
            <view class="card-picker">{{budgetIndex >= 0 ? budgetOptions[budgetIndex] : '请选择'}}</view>
          </picker>
        </view>
        <view class="card-form-item">
          <text class="card-form-label">拍照技能</text>
          <picker range="{{photoOptions}}" value="{{photoIndex}}" bindchange="onPhotoChange">
            <view class="card-picker">{{photoIndex >= 0 ? photoOptions[photoIndex] : '请选择'}}</view>
          </picker>
        </view>
        <view class="card-form-item">
          <text class="card-form-label">住宿偏好</text>
          <picker range="{{accommodationOptions}}" value="{{accommodationIndex}}" bindchange="onAccommodationChange">
            <view class="card-picker">{{accommodationIndex >= 0 ? accommodationOptions[accommodationIndex] : '请选择'}}</view>
          </picker>
        </view>
        <view class="card-form-item">
          <text class="card-form-label">驾驶</text>
          <picker range="{{drivingOptions}}" value="{{drivingIndex}}" bindchange="onDrivingChange">
            <view class="card-picker">{{drivingIndex >= 0 ? drivingOptions[drivingIndex] : '请选择'}}</view>
          </picker>
        </view>
        <view class="card-form-item">
          <text class="card-form-label">兴趣标签</text>
          <view class="card-tag-options">
            <text wx:for="{{tagOptions}}" wx:key="*this"
                  class="card-tag-option {{editTags.indexOf(item) >= 0 ? 'card-tag-selected' : ''}}"
                  bindtap="onToggleTag" data-tag="{{item}}">{{item}}</text>
          </view>
        </view>
        <view class="card-form-btns">
          <button class="card-btn-cancel" size="mini" bindtap="onCancelCard">取消</button>
          <button class="card-btn-save" size="mini" loading="{{cardSaving}}" bindtap="onSaveCard">保存</button>
        </view>
      </block>
    </view>

    <view class="card menu-card">
      <view class="menu-item" bindtap="onEditProfile">
        <text class="menu-icon">✏️</text>
        <text class="menu-text">编辑资料</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goMyTrips">
        <text class="menu-icon">🗺️</text>
        <text class="menu-text">我发布的行程</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goMyGuides">
        <text class="menu-icon">📖</text>
        <text class="menu-text">我的攻略</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goMyMatches">
        <text class="menu-icon">🤝</text>
        <text class="menu-text">我的搭子</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goSettings">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">设置</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <button class="btn-logout" bindtap="onLogout">退出登录</button>

    <!-- 我发布的行程列表 -->
    <view wx:if="{{isLoggedIn}}" class="card" style="margin-top: 20rpx;">
      <view class="card-title">我发布的行程</view>

      <view wx:if="{{myTripsLoading}}" class="loading-text">加载中...</view>
      <view wx:elif="{{myTripsEmpty}}" class="hint-text">暂无发布的行程</view>

      <view wx:for="{{myTrips}}" wx:key="companion_id" class="trip-card" bindtap="onTripDetail" data-trip="{{item}}">
        <view class="trip-cities">
          <text wx:for="{{item.route.cities}}" wx:for-item="city" wx:key="*this" class="city-badge">{{city}}</text>
        </view>
        <view class="trip-meta">
          <text class="trip-date">{{item.travel_date || '待定'}}</text>
          <text class="trip-sep">·</text>
          <text class="trip-days">{{item.duration_days || 0}}天</text>
          <text class="trip-sep">·</text>
          <text class="trip-people">{{item.current_people || '未知'}}</text>
        </view>
        <view class="trip-tags">
          <text class="trip-tag">{{item.transport_mode || '不限'}}</text>
          <text class="trip-tag">{{item.accommodation || '不限'}}</text>
          <text class="trip-tag">{{item.budget_level || '经济'}}</text>
          <text class="trip-tag">{{item.good_at_photo || '不限'}}</text>
        </view>
        <view class="trip-footer">
          <view class="trip-created">发布于 {{item.created_at || '未知'}}</view>
          <view class="trip-delete" catchtap="onDeleteTrip" data-id="{{item.companion_id}}">删除</view>
        </view>
      </view>
    </view>
  </view>
</view>
