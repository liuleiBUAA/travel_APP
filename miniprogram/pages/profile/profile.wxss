.login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60rpx;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.avatar-icon {
  font-size: 80rpx;
}

.login-hint {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.input-fix {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #333;
  background: #fafafa;
}

.divider {
  display: flex;
  align-items: center;
  margin: 30rpx 0;
  color: #ccc;
  font-size: 26rpx;
  text-align: center;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #e0e0e0;
  margin: 0 20rpx;
}

.btn-wechat {
  width: 100%;
  background: #07c160;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wechat-icon {
  margin-right: 10rpx;
}

/* 已登录 */
.profile-section {
  padding-top: 20rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255,255,255,0.6);
  margin-right: 30rpx;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.menu-card {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.btn-logout {
  width: 100%;
  background: #fff;
  color: #f5576c;
  border: 2rpx solid #f5576c;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  margin-top: 20rpx;
}

/* 行程卡片 */
.trip-card {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.trip-card:last-child {
  border-bottom: none;
}
.trip-cities {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.city-badge {
  background: #e8f4ff;
  color: #1677ff;
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
  font-size: 24rpx;
}
.trip-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 10rpx;
}
.trip-date, .trip-days, .trip-people {
  font-size: 26rpx;
  color: #666;
}
.trip-sep {
  color: #ccc;
  font-size: 26rpx;
}
.trip-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.trip-tag {
  background: #f5f5f5;
  color: #666;
  border-radius: 4rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
}
.trip-created {
  font-size: 22rpx;
  color: #999;
}

.loading-text {
  color: #999;
  font-size: 26rpx;
  text-align: center;
  padding: 40rpx 0;
}

.hint-text {
  color: #bbb;
  font-size: 26rpx;
  text-align: center;
  padding: 40rpx 0;
}

/* 完善资料弹窗 */
.profile-setup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.profile-setup-dialog {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.setup-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.setup-hint {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 40rpx;
}

.setup-avatar-wrap {
  margin-bottom: 30rpx;
}

.setup-avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  padding: 0;
  line-height: normal;
}

.setup-avatar-btn::after {
  border: none;
}

.setup-avatar-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
  border: 4rpx dashed #ccc;
}

.setup-avatar-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.setup-nickname-wrap {
  width: 100%;
  margin-bottom: 40rpx;
}

.setup-nickname-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
}

.setup-btns {
  display: flex;
  width: 100%;
  gap: 20rpx;
}

.setup-btn-skip {
  flex: 1;
  background: #f5f5f5;
  color: #666;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
}

.setup-btn-confirm {
  flex: 1;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 0;
}
