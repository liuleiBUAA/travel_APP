<view class="container">
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:else class="detail-content">
    <!-- 路线 hero -->
    <view class="card route-card">
      <view class="route-publisher" bindtap="goAuthorProfile">
        <image wx:if="{{detail.author.avatar_url}}" class="publisher-avatar-img" src="{{detail.author.avatar_url}}" mode="aspectFill" />
        <view wx:else class="publisher-avatar">{{detail.user_name ? detail.user_name[0] : '旅'}}</view>
        <view class="publisher-info">
          <view class="publisher-name">{{detail.user_name}} <text wx:if="{{detail.author}}" class="publisher-arrow">›</text></view>
          <view class="publisher-meta">{{detail.travel_date}} 出发 · {{detail.duration_days}}天 · ±{{detail.flexibility_days}}天</view>
          <view wx:if="{{detail.author && (detail.author.budget_level || detail.author.driving || detail.author.good_at_photo || detail.author.accommodation_pref)}}" class="publisher-card-tags">
            <text wx:if="{{detail.author.budget_level}}" class="publisher-card-tag">💰{{detail.author.budget_level}}</text>
            <text wx:if="{{detail.author.good_at_photo}}" class="publisher-card-tag">📷{{detail.author.good_at_photo}}</text>
            <text wx:if="{{detail.author.accommodation_pref}}" class="publisher-card-tag">🏨{{detail.author.accommodation_pref}}</text>
            <text wx:if="{{detail.author.driving}}" class="publisher-card-tag">🚗{{detail.author.driving}}</text>
          </view>
        </view>
      </view>
      <view class="cities-list">
        <block wx:for="{{route.cities}}" wx:key="index">
          <text class="city">{{item}}</text>
          <text wx:if="{{index < route.cities.length - 1}}" class="arrow">→</text>
        </block>
      </view>
      <view class="route-stats">
        <view class="stat-item">
          <view class="stat-num">{{route.city_count || route.cities.length}}</view>
          <view class="stat-label">城市</view>
        </view>
        <view class="stat-item">
          <view class="stat-num">{{detail.duration_days}}</view>
          <view class="stat-label">天数</view>
        </view>
        <view class="stat-item">
          <view class="stat-num">{{detail.current_people}}</view>
          <view class="stat-label">现有成员</view>
        </view>
      </view>
    </view>

    <!-- 联系 / 分享操作区 -->
    <view class="card action-card">
      <!-- 未登录 -->
      <view wx:if="{{!isLoggedIn}}" class="contact-row contact-locked" bindtap="goLogin">
        <view class="contact-left">
          <text class="contact-icon">🔒</text>
          <view class="contact-label">登录后可申请和TA交换微信</view>
        </view>
        <view class="contact-copy">去登录</view>
      </view>
      <!-- 自己的帖子：从留言区向留言者发起 -->
      <block wx:elif="{{!detail.is_mine}}">
        <!-- 已交换成功 -->
        <view wx:if="{{exchangeStatus === 'accepted'}}" class="contact-row" bindtap="copyWechat">
          <view class="contact-left">
            <text class="contact-icon">💬</text>
            <view>
              <view class="contact-label">已交换微信</view>
              <view class="contact-value">{{exchange.other_wechat_id}}</view>
            </view>
          </view>
          <view class="contact-copy">复制</view>
        </view>
        <!-- 我发出的申请等待处理 -->
        <view wx:elif="{{exchangeStatus === 'pending' && exchange.is_sender}}" class="contact-row contact-none">
          <view class="contact-left">
            <text class="contact-icon">⏳</text>
            <view class="contact-label">已申请交换微信，等待对方同意</view>
          </view>
        </view>
        <!-- 对方向我发的申请 -->
        <view wx:elif="{{exchangeStatus === 'pending' && !exchange.is_sender}}" class="contact-row">
          <view class="contact-left">
            <text class="contact-icon">💬</text>
            <view class="contact-label">TA想和你交换微信</view>
          </view>
          <view class="exchange-handle-btns">
            <view class="exchange-reject" catchtap="onRejectExchange">拒绝</view>
            <view class="exchange-accept" catchtap="onAcceptExchange">同意</view>
          </view>
        </view>
        <!-- 被拒冷却 -->
        <view wx:elif="{{exchangeStatus === 'rejected' && exchange.is_sender}}" class="contact-row contact-none">
          <view class="contact-left">
            <text class="contact-icon">💬</text>
            <view class="contact-label">对方暂未同意交换，过几天可再试</view>
          </view>
        </view>
        <!-- 可发起申请 -->
        <view wx:else class="contact-row" bindtap="onRequestExchange">
          <view class="contact-left">
            <text class="contact-icon">💬</text>
            <view class="contact-label">留言聊得来？申请和TA交换微信</view>
          </view>
          <view class="contact-copy">申请</view>
        </view>
      </block>

      <view class="action-btns">
        <button class="btn-share" open-type="share">
          <text>↗️ 分享这条行程</text>
        </button>
        <button wx:if="{{detail.is_mine}}" class="btn-delete" bindtap="onDelete">删除</button>
      </view>
    </view>

    <!-- 出行偏好 -->
    <view class="card preference-card">
      <view class="card-title">出行偏好</view>
      <view class="pref-tags">
        <view class="pref-tag">🚄 {{detail.transport_mode || '不限'}}</view>
        <view class="pref-tag">🏨 {{detail.accommodation || '不限'}}</view>
        <view class="pref-tag">💰 {{detail.budget_level || '经济'}}</view>
        <view class="pref-tag">📷 {{detail.good_at_photo || '不限'}}</view>
      </view>
    </view>

    <!-- 找搭子需求 -->
    <view class="card seeking-card">
      <view class="card-title">想找的搭子</view>
      <view class="info-row">
        <text class="label">人数：</text>
        <text class="value">{{seeking.people_min || 1}}-{{seeking.people_max || 2}}人</text>
      </view>
      <view class="info-row">
        <text class="label">性别：</text>
        <text class="value">{{seeking.gender || '不限'}}</text>
      </view>
      <view wx:if="{{seeking.age_range}}" class="info-row">
        <text class="label">年龄：</text>
        <text class="value">{{seeking.age_range}}</text>
      </view>
    </view>

    <!-- 每日行程 -->
    <view wx:if="{{route.itinerary && route.itinerary.length > 0}}" class="card itinerary-card">
      <view class="card-title">每日行程</view>
      <view class="itinerary-list">
        <block wx:for="{{route.itinerary}}" wx:key="day">
          <view class="day-item">
            <view class="day-header">Day {{item.day}}<text wx:if="{{item.city || item.stay}}" class="day-city"> · {{item.city || item.stay}}</text></view>
            <view class="day-content">
              <view wx:if="{{item.activity || item.activities}}" class="day-row">
                <text class="day-label">活动</text>
                <text class="day-value">{{item.activity || item.activities}}</text>
              </view>
              <view wx:if="{{item.transport}}" class="day-row">
                <text class="day-label">交通</text>
                <text class="day-value">{{item.transport}}</text>
              </view>
              <view wx:if="{{item.accommodation}}" class="day-row">
                <text class="day-label">住宿</text>
                <text class="day-value">{{item.accommodation}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- 留言区 -->
    <view class="card comments-card">
      <view class="card-title">留言（{{comments.length}}）</view>

      <view wx:if="{{commentsLoading}}" class="loading-text">加载中...</view>
      <view wx:elif="{{comments.length === 0}}" class="comments-empty">还没有留言，问问行程细节，聊几句再加微信～</view>

      <view wx:for="{{comments}}" wx:key="comment_id" class="comment-item">
        <image class="comment-avatar" src="{{item.avatar_url || '/images/default_avatar.png'}}" mode="aspectFill"
               bindtap="goCommenterProfile" data-uid="{{item.user_id}}" />
        <view class="comment-body">
          <view class="comment-head">
            <text class="comment-nickname" bindtap="goCommenterProfile" data-uid="{{item.user_id}}">{{item.nickname}}</text>
            <text class="comment-time">{{item.created_at}}</text>
          </view>
          <view class="comment-content">{{item.content}}</view>
          <view class="comment-actions">
            <view wx:if="{{detail.is_mine && !item.is_mine}}" class="comment-exchange"
                  bindtap="onRequestExchangeWith" data-uid="{{item.user_id}}" data-nickname="{{item.nickname}}">换微信</view>
            <view wx:if="{{item.is_mine}}" class="comment-delete" bindtap="onDeleteComment" data-id="{{item.comment_id}}">删除</view>
          </view>
        </view>
      </view>

      <!-- 输入区 -->
      <view wx:if="{{isLoggedIn}}" class="comment-input-row">
        <input class="comment-input" value="{{commentInput}}" maxlength="500"
               placeholder="问问行程细节..." bindinput="onCommentInput" confirm-type="send" bindconfirm="onSubmitComment" />
        <button class="comment-send" size="mini" loading="{{commentSubmitting}}" bindtap="onSubmitComment">发送</button>
      </view>
      <view wx:else class="comment-login-hint" bindtap="goLogin">登录后留言</view>
    </view>
  </view>
</view>
