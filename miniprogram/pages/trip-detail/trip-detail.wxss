.container {
  min-height: 100vh;
  background: var(--c-bg);
  padding: 20rpx;
}

.loading {
  padding: 200rpx 0;
  text-align: center;
  color: var(--c-text-muted);
}

.detail-content {
  padding-bottom: 40rpx;
}

.card {
  background: var(--c-card);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: var(--shadow-card);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--c-text);
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--c-border-soft);
}

/* 路线城市卡片 */
.route-card {
  background: var(--grad-primary);
  color: white;
}

.route-card .card-title {
  color: white;
  border-bottom-color: rgba(255, 255, 255, 0.2);
}

.cities-list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.city {
  font-size: 28rpx;
  font-weight: 500;
}

.arrow {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 信息行 */
.info-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--c-border-soft);
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: var(--c-text-sub);
  min-width: 180rpx;
}

.value {
  font-size: 28rpx;
  color: var(--c-text);
  flex: 1;
}

/* 每日行程 */
.itinerary-list {
  margin-top: 10rpx;
}

.day-item {
  margin-bottom: 30rpx;
  border-left: 4rpx solid var(--c-primary);
  padding-left: 20rpx;
}

.day-item:last-child {
  margin-bottom: 0;
}

.day-header {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--c-primary);
  margin-bottom: 16rpx;
}

.day-content {
  background: var(--c-input-bg);
  border-radius: 12rpx;
  padding: 20rpx;
}

.day-row {
  display: flex;
  margin-bottom: 12rpx;
}

.day-row:last-child {
  margin-bottom: 0;
}

.day-label {
  font-size: 26rpx;
  color: var(--c-text-muted);
  min-width: 100rpx;
}

.day-value {
  font-size: 26rpx;
  color: var(--c-text-sub);
  flex: 1;
}
