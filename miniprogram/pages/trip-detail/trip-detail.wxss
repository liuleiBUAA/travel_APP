.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.loading {
  padding: 200rpx 0;
  text-align: center;
  color: #999;
}

.detail-content {
  padding-bottom: 40rpx;
}

.card {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

/* 路线城市卡片 */
.route-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.route-card .card-title {
  color: white;
  border-bottom-color: rgba(255, 255, 255, 0.2);
}

.cities-list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.city {
  font-size: 28rpx;
  font-weight: 500;
}

.arrow {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 信息行 */
.info-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #666;
  min-width: 180rpx;
}

.value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

/* 每日行程 */
.itinerary-list {
  margin-top: 10rpx;
}

.day-item {
  margin-bottom: 30rpx;
  border-left: 4rpx solid #667eea;
  padding-left: 20rpx;
}

.day-item:last-child {
  margin-bottom: 0;
}

.day-header {
  font-size: 30rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 16rpx;
}

.day-content {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.day-row {
  display: flex;
  margin-bottom: 12rpx;
}

.day-row:last-child {
  margin-bottom: 0;
}

.day-label {
  font-size: 26rpx;
  color: #999;
  min-width: 100rpx;
}

.day-value {
  font-size: 26rpx;
  color: #666;
  flex: 1;
}
