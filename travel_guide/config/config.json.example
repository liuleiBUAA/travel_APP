{
  "同": "这是配置文件示例，复制为 config.json 后修改使用",

  "same_day_max_hours": 4.0,
  "注释1": "跨城交通时间阈值（小时）。超过此值需要单独一天大交通",

  "check_low_freq_flights": false,
  "注释2": "是否联网查询低频航班时刻（需要Playwright）",

  "options_display_mode": "detailed",
  "注释3": "Options显示模式。详细模式(detailed)显示所有选项；简洁模式(compact)只显示选择结果",

  "force_gateway_departure": false,
  "注释3b": "是否强制从国际门户城市离开（true则自动选择最近的直飞城市；false则使用最后一站）",

  "transport_preference": "auto",
  "注释3c": "交通方式偏好。可选值：auto(自动)、train(优先火车)、drive(优先自驾)。只影响没有飞机时的火车vs自驾选择",

  "destinations": ["巴黎", "阿姆斯特丹", "布鲁塞尔"],
  "注释4": "目的地列表（可选，也可以通过命令行传入）",

  "start_city": "巴黎",
  "注释5": "起点城市（可选，不指定则使用第一个目的地）",

  "end_city": "布鲁塞尔",
  "注释6": "终点城市（可选，不指定则使用最后一个目的地）",

  "force_order": false,
  "注释7": "是否强制按输入顺序（false则自动优化避免走回头路）",

  "region": "欧洲",
  "注释8": "区域名称（可选，不指定则自动检测）。可选值：欧洲、北美、澳洲、亚洲"
}
